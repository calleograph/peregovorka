{
  "name": "peregovorka-desktop",
  "productName": "Peregovorka",
  "version": "1.0.0",
  "private": true,
  "description": "Peregovorka для Windows",
  "author": "Peregovorka",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "node build.mjs && tsc --noEmit",
    "test": "node build.mjs --test && node --test \"dist/test/*.test.js\"",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win nsis --x64 --publish never"
  },
  "peregovorka": {
    "updateFeed": "https://github.com/calleograph/peregovorka/releases/download/desktop-channel/update.json"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "electron@44.9.3": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
