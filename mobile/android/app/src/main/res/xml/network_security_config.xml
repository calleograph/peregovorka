<?xml version="1.0" encoding="utf-8"?>
<!-- Только HTTPS. Корпоративные центры сертификации, установленные на устройство (в том числе через MDM), принимаются: без них приложение не работает за корпоративным прокси.
     Недоверенный сертификат система отвергает, обходной «принять любой» в приложении нет. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
