# Проверенный набор версий компонентов реального времени. ИНФОРМАЦИОННЫЙ файл: установщик сравнивает с ним и при
# отличии только предупреждает — можно ставить более новые версии (scripts/check-updates.sh покажет, что вышло).
# Решающая проверка совместимости — не номер версии, а реальный WebSocket Upgrade на /rtc/v1 (scripts/smoke-test.sh):
# и браузерный JS-клиент, и Python-клиент ASR сначала подключаются по /rtc/v1; сервер, который отвечает 404, вынуждает их
# переходить на запасной путь /rtc, и вход в комнату затягивается на секунды (наблюдалось на LiveKit Server v1.9.0).
# Синхронизируется тестом tests/scripts (значения должны совпадать с requirements.txt / package-lock.json / Dockerfile).
TESTED_LIVEKIT_SERVER=v1.13.10
TESTED_LIVEKIT_CLIENT_JS=2.23.0
TESTED_LIVEKIT_PYTHON_SDK=1.1.21
TESTED_LIVEKIT_API_PYTHON=1.2.2
# Наименьшая версия сервера, с которой вход в комнату не затягивается (v1.9.0 отвечает 404 на /rtc/v1). Ниже — предупреждение диагностики; не путать с проверенной (TESTED_*).
MIN_LIVEKIT_SERVER=v1.13.7
