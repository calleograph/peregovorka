# =============================================================================
# .env.example — описание ВСЕХ переменных конфигурации экземпляра.
#
# Копия для сервера: `cp .env.example .env && chmod 600 .env`, затем заполнить.
# Настоящий .env в Git не хранится. Значения ниже — ПРИМЕРЫ формата, а не
# рекомендации: порты и адреса никогда не занимаются автоматически, каждый
# обязан быть выбран явно и проверен `scripts/preflight.sh`.
# Значения-заглушки (начинаются на CHANGE) обязательны к замене — preflight откажет, если остались.
# =============================================================================

# ----------------------------------------------------------------------------
# Экземпляр и профиль установки
# ----------------------------------------------------------------------------
# Уникальное имя compose-проекта на этом хосте. Префикс имён контейнеров,
# сетей и volumes. Только a-z, 0-9, '-', '_'; начинается с буквы.
COMPOSE_PROJECT_NAME=peregovorka-prod

# shared-host — уже работающий сервер с другими приложениями (максимально
# консервативный режим, Docker считается внешней зависимостью).
# standalone — новый выделенный Ubuntu Server (может ставить пакеты и Docker).
INSTALL_PROFILE=shared-host

# Публичный URL приложения для пользователей (схема + хост, без пути).
# Используется для проверки Origin (WebSocket/CSRF) и ссылок. Нужен HTTPS:
# браузер не даст доступ к микрофону на http:// (кроме localhost).
APP_PUBLIC_URL=https://meet.example.org

# Каталог с Git checkout (заполняется install.sh/deploy.sh; для справки).
# Пример shared-host: /var/www/projects/peregovorka ; standalone: /opt/peregovorka
APP_ROOT=/opt/peregovorka

# Корень ПОСТОЯННЫХ данных (вне Git checkout): postgres/, redis/, models/,
# recordings/, exports/, backups/. ЛОКАЛЬНЫЙ абсолютный Linux-каталог (не \сервер\ресурс и не smb://).
# Сетевое SMB-хранилище протоколов настраивается в админке → «Хранилище».
DATA_ROOT=/srv/peregovorka-data

# Метки версии (проставляются deploy.sh; руками обычно не трогать).
APP_VERSION=0.1.0
APP_GIT_COMMIT=unknown
# Тег локально собираемых образов этого проекта (deploy.sh ставит = короткий SHA).
IMAGE_TAG=dev

# Уровень и формат логов приложения: DEBUG|INFO|WARNING|ERROR ; json|console
LOG_LEVEL=INFO
LOG_FORMAT=json

# ----------------------------------------------------------------------------
# Порты хоста (все обязательны, значений по умолчанию нет — выбирает админ)
# ----------------------------------------------------------------------------
# Веб-вход (контейнер web). По умолчанию слушаем только loopback: наружу
# выставляет host-nginx/внешний reverse proxy.
WEB_BIND_ADDR=127.0.0.1
WEB_PORT=18480

# LiveKit: API/WebSocket сигналинг. Публикуется ТОЛЬКО на loopback, нужен
# host-nginx/диагностике. Браузеры ходят через web:/livekit/.
LIVEKIT_HTTP_PORT=17880
# LiveKit ICE/TCP (fallback, когда UDP заблокирован) и ICE/UDP (один mux-порт
# вместо диапазона, односерверный разворот).
LIVEKIT_BIND_ADDR=0.0.0.0
LIVEKIT_TCP_PORT=17881
LIVEKIT_UDP_PORT=17882

# ----------------------------------------------------------------------------
# LiveKit
# ----------------------------------------------------------------------------
# Версия серверного образа livekit/livekit-server: latest (по умолчанию — самая новая) или конкретный тег (например v1.13.7).
# Клиенты (браузер, ASR) обратно совместимы с более НОВЫМИ серверами, поэтому свежий сервер безопасен; опасны СТАРЫЕ:
# сервер v1.9.0 не знает /rtc/v1, отвечает 404, и вход в комнату затягивается на секунды. Проверено на v1.13.7
# (deployment/compat.env). Обновить до новейшей: scripts/deploy.sh --pull; проверить: scripts/smoke-test.sh.
LIVEKIT_IMAGE_TAG=latest
# IP-адрес сервера, который браузеры используют для ICE-подключения (LAN-IP).
# Обязателен: use_external_ip отключён — внешние STUN-сервисы не используются.
LIVEKIT_NODE_IP=192.0.2.10
# Ключ/секрет API LiveKit (секрет: >= 32 символов, `openssl rand -hex 32`).
LIVEKIT_API_KEY=CHANGE_ME_livekit_key
LIVEKIT_API_SECRET=CHANGE_ME_livekit_secret_at_least_32_chars
# Адрес сигналинга ДЛЯ БРАУЗЕРА (проксируется контейнером web по /livekit).
LIVEKIT_PUBLIC_URL=wss://meet.example.org/livekit
# Время жизни пользовательского токена подключения, секунды.
LIVEKIT_TOKEN_TTL_SECONDS=300
# Сколько секунд LiveKit держит комнату открытой после ухода всех участников (обновление страницы,
# кратковременный обрыв сети) и сколько — совсем пустую комнату. Комната не удаляется мгновенно.
LIVEKIT_ROOM_DEPARTURE_TIMEOUT=60
LIVEKIT_ROOM_EMPTY_TIMEOUT=300

# ----------------------------------------------------------------------------
# PostgreSQL и Redis (доступны только во внутренней docker-сети проекта)
# ----------------------------------------------------------------------------
POSTGRES_DB=peregovorka
POSTGRES_USER=peregovorka
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
REDIS_PASSWORD=CHANGE_ME_redis_password

# ----------------------------------------------------------------------------
# Swagger/OpenAPI (/api/v1/docs, /api/v1/openapi.json): true — только для отладки, в рабочей среде выключено.
DOCS_ENABLED=false

# ----------------------------------------------------------------------------
# Секреты приложения
# ----------------------------------------------------------------------------
# Мастер-ключ шифрования секретов в БД (base64 от 32 случайных байт):
#   openssl rand -base64 32
# ПОТЕРЯ КЛЮЧА = потеря зашифрованных настроек (пароли хранилища и т.п.).
APP_MASTER_KEY=CHANGE_ME_base64_32_bytes
# Токен для внутренних сервисных вызовов (asr -> backend, smoke-test):
#   openssl rand -hex 32
INTERNAL_API_TOKEN=CHANGE_ME_internal_token

# ----------------------------------------------------------------------------
# Active Directory (LDAPS обязателен, проверка сертификата обязательна)
# ----------------------------------------------------------------------------
# Один или несколько серверов через запятую; только схема ldaps://.
LDAP_URIS=ldaps://dc1.corp.example.org:636,ldaps://dc2.corp.example.org:636
LDAP_BASE_DN=DC=corp,DC=example,DC=org
# Сервисная учётка ТОЛЬКО на чтение каталога.
LDAP_BIND_DN=CN=svc-peregovorka,OU=Service,DC=corp,DC=example,DC=org
LDAP_BIND_PASSWORD=CHANGE_ME_ldap_bind_password
# Путь НА ХОСТЕ к PEM-файлу доверенного CA (цепочки) контроллеров домена.
# Монтируется в контейнер backend read-only.
LDAP_CA_FILE=/etc/peregovorka/ad-ca.pem
# Атрибут логина и отображаемого имени.
LDAP_LOGIN_ATTRIBUTE=sAMAccountName
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
# DN группы администраторов системы (полный DN).
LDAP_ADMIN_GROUP_DN=CN=Peregovorka-Admins,OU=Groups,DC=corp,DC=example,DC=org
# Если задан — входить могут только члены этой группы (пусто = любой доменный
# пользователь с активной учёткой; доступ к комнатам всё равно по ACL).
LDAP_ACCESS_GROUP_DN=
LDAP_TIMEOUT_SECONDS=5

# ----------------------------------------------------------------------------
# Сессии и защита входа
# ----------------------------------------------------------------------------
# Secure-флаг cookie. true — всегда, кроме локальной разработки по http.
COOKIE_SECURE=true
# Сколько прокси стоит ПЕРЕД контейнером web и добавляет адрес клиента в X-Forwarded-For
# (host-nginx = 1; внешний reverse proxy + host-nginx = 2). Нужно для лимитов по IP и аудита.
TRUSTED_PROXY_HOPS=1
SESSION_IDLE_TIMEOUT_SECONDS=28800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400
# Неудачных попыток входа на ЛОГИН в окне до временного отказа БЕЗ обращения
# к AD. Держите ниже порога блокировки учёток в AD (обычно 5-10).
LOGIN_MAX_FAILURES_PER_USER=3
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# ----------------------------------------------------------------------------
# Хранение: сроки по умолчанию для новых комнат (дней; 0 = не хранить/удалять сразу
# после обработки; пустое = бессрочно). Переопределяются в настройках комнаты.
# ----------------------------------------------------------------------------
DEFAULT_TEXT_RETENTION_DAYS=365
DEFAULT_AUDIO_RETENTION_DAYS=30
# Задержка после выхода последнего участника, после которой встреча
# автоматически завершается, секунды (льготный период: обновление страницы, обрыв сети, перезапуск ASR).
MEETING_END_GRACE_SECONDS=60

# ----------------------------------------------------------------------------
# ASR-сервис
# ----------------------------------------------------------------------------
# Провайдер: gigaam (реализован). Будущие: whisper и др.
ASR_PROVIDER=gigaam
ASR_MODEL_NAME=v3_e2e_rnnt
# Устройство: cpu | cuda. Для cuda нужен compose.gpu.yml и NVIDIA Container Toolkit.
ASR_DEVICE=cpu
# Одновременных инференсов (одна общая копия модели; GigaAM потокобезопасен — см. docs/realtime-performance-audit.md §F4) и размер очереди сегментов.
# ВАЖНО: ASR_CPU_THREADS × ASR_MAX_CONCURRENT_INFERENCE не должно превышать число ядер (иначе распознавания мешают друг другу и растёт задержка);
# например 8 vCPU: 6 × 1 или 3 × 2, но не 6 × 2. Выгоду параллелизма измеряет: scripts/asr-bench.sh --concurrency 1,2
ASR_MAX_CONCURRENT_INFERENCE=1
ASR_QUEUE_SIZE=64
# Потоки torch на CPU. 0 = все ядра хоста (подходит ТОЛЬКО для выделенного сервера). Рекомендации по числу vCPU:
#   4 vCPU (shared-host): ASR_CPU_THREADS=2, ASR_INTEROP_THREADS=1
#   8 vCPU (shared-host): ASR_CPU_THREADS=4, ASR_INTEROP_THREADS=1..2
# Значение выбирайте по задержке распознавания, а не по загрузке CPU: scripts/asr-bench.sh сравнивает варианты (RTF, задержка).
ASR_CPU_THREADS=0
# Межоперационные потоки torch (0 = по умолчанию библиотеки).
ASR_INTEROP_THREADS=0
ASR_LANGUAGE=ru
# Модель распознавания выбирается в админке (Интеграции → Распознавание речи): Full (PyTorch) или Q5_K_M (GGUF); обе могут лежать в
# DATA_ROOT/models/gigaam одновременно. Здесь — запасной вариант до первого выбора и настройки runtime GGUF (transcribe.cpp).
ASR_MODEL_ID=gigaam-v3-e2e-rnnt-full
ASR_GGUF_BIN=transcribe
ASR_GGUF_ARGS="-m {model} -f {wav} -t {threads}"
# VAD: порог вероятности речи, пауза-конец реплики (мс), минимальная длина речи (мс),
# предварительный/хвостовой захват (мс), максимальная длина одного сегмента (с, GigaAM <= 25).
ASR_VAD_THRESHOLD=0.5
ASR_VAD_END_SILENCE_MS=700
ASR_VAD_MIN_SPEECH_MS=250
ASR_VAD_PAD_MS=200
ASR_MAX_SEGMENT_SECONDS=20
# Индекс URL для torch при сборке образа (CPU: https://download.pytorch.org/whl/cpu).
ASR_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Источник весов для scripts/models.sh (база URL с <model>.ckpt и <model>_tokenizer.model).
# Для закрытой сети используйте `scripts/models.sh --from-dir <каталог>`.
GIGAAM_MODEL_BASE_URL=https://cdn.chatwm.opensmodel.sberdevices.ru/GigaAM
# Коммит GigaAM (pin) для сборки образа ASR.
GIGAAM_GIT_COMMIT=7447938d791c4f3e643386ee22c33777004293a5

# ----------------------------------------------------------------------------
# Host nginx (профили shared-host / standalone; создаётся ОТДЕЛЬНЫЙ site-файл)
# ----------------------------------------------------------------------------
NGINX_MANAGE=yes
# Уникальное имя site-файла; чужие файлы (в т.ч. sites-available/projects) не трогаются.
NGINX_SITE_NAME=peregovorka-prod
NGINX_SERVER_NAME=meet.example.org
# Порт, на котором host-nginx принимает трафик (за внешним reverse proxy — обычно HTTP).
NGINX_LISTEN_PORT=18400
# Для standalone с TLS на этом nginx: пути к сертификату и ключу (иначе пусто = без TLS).
NGINX_TLS_CERT=
NGINX_TLS_KEY=
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled

# ----------------------------------------------------------------------------
# Резервные копии и проверки
# ----------------------------------------------------------------------------
BACKUP_DIR=/srv/peregovorka-data/backups
# Минимумы для preflight.sh. RAM сравнивается в КиБ с допуском на накладные расходы ВМ:
# >=90% от MIN_RAM_GB — ок, 75–90% — предупреждение, меньше — отказ.
MIN_FREE_DISK_GB=30
MIN_RAM_GB=8
